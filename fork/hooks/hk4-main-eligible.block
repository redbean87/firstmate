# >>> fork resurface-guard hook HK4 (fork/README; fork edit in this file)
# The main-eligible resurface guard both HK3 and HK5 call: it answers whether
# main would actually receive a queued row it has not already been shown - the
# same main-eligible filter bin/fm-wake-drain.sh applies - so a queue held
# wholly by a live supervision-branch grant cannot wake main with nothing for
# it to present.
# fm_wake_actor_pending_count (bin/fm-wake-lib.sh) owns that filter; it reads
# without the queue lock by contract, where a torn read can only mis-count one
# poll, and reports an uncountable queue as pending so a queue nobody can read
# still alarms.
# A row the drain already presented to main stays queued until main's
# acknowledgement, and the next watcher's startup lands inside that window, so
# state/.main-eligible-rows (the drain's presented-row claim) is subtracted:
# main is already handling those rows, and announcing them again is the empty
# "watching resumed" turn. An absent or invalid claim subtracts nothing.
fork_main_eligible_queued_row() {
  local claim="$STATE/.main-eligible-rows" view count
  if [ -f "$claim" ] && [ ! -L "$claim" ] && fm_wake_grant_rows_valid "$claim" && [ -f "$FM_WAKE_QUEUE" ]; then
    view=$(mktemp "$STATE/.fork-resurface-view.XXXXXX") || return 0
    if awk -F '\t' -v seqs="$claim" '
      BEGIN { while ((getline line < seqs) > 0) presented[line] = 1 }
      NF < 5 || $2 !~ /^[0-9]+$/ || !($2 in presented) { print }
    ' "$FM_WAKE_QUEUE" > "$view"; then
      count=$(FM_WAKE_QUEUE=$view fm_wake_actor_pending_count main)
    else
      count=1
    fi
    rm -f -- "$view"
    [ "$count" -gt 0 ]
    return
  fi
  [ "$(fm_wake_actor_pending_count main)" -gt 0 ]
}
# <<< fork resurface-guard hook HK4
