#!/usr/bin/env bash
# fm-brief-intake-check - the Firstmate fork's dispatch preflight for written
# ship and scout briefs. It refuses a brief that still carries one of the
# intake defects that cost real review rounds: the three from the 2026-10-29
# post-mortem (a slice intent that reads as the whole capability, an unnamed
# project check set, and conflicting bounded promises with no stated
# composition) and the two write-scope defects behind two lost worker passes
# (a brief that declares its outside-worktree write targets and still carries
# the standard containment sentence, and a brief that names an outside write
# target without declaring it). It says exactly which element or line the
# brief needs instead.
#
# Usage: fm-brief-intake-check <brief-file>
#
# Firstmate's brief-intake policy (fork/bin/fm-launch-policy) calls this
# before every ship and scout launch - fresh spawn, relaunch, and relaunch
# preflight - and firstmate can run it standalone against a written brief
# before dispatch. The markers are lines, so the verdict is a grep rather
# than a judgement call.
#
# Required brief elements. Each is one line anywhere in the file; optional
# leading whitespace or a markdown bullet (-, *, +) before the marker is
# accepted, and the value must sit on that same line:
#
#   Delivers: <what this slice delivers>
#       The slice's own behaviour - never the whole capability, or review
#       re-files "it cannot do the thing" every round.
#   Defers: <what this slice defers, or nothing>
#       The complement, so a partial slice cannot read as the whole ask.
#   Checks: <the project's full check set>
#       Named explicitly, resolved at intake from the project's own scripts
#       or CI and never from memory. This check proves the brief NAMES a
#       check set; completeness of that set stays firstmate's intake duty
#       (fork/brief-intake-note states the fill rule).
#   Bound: <one bounded promise - a for-every guarantee or a shared budget>
#       Repeatable: one line per bounded promise or rate limit. Two or more
#       Bound: lines additionally require the composition element below.
#   Composition: <how those bounded promises compose when they conflict, and
#                 the test that pins that combined promise>
#       Without it, review discovers one starvation route per round while
#       each fix passes its own mechanism test.
#   Write outside worktree: <absolute paths or directories>
#       Declares real write targets outside the worktree on its own line (a
#       filled brief puts it in its Task section). Conditional like
#       Composition: required whenever the brief names any outside write
#       target (the write-scope refusals below), omitted when it names none.
#
# Write-scope refusals. Both are line-mechanical like the elements above:
#
#   - A brief that declares 'Write outside worktree:' while still carrying
#     the standard containment sentence ('Stay inside this worktree; outside
#     it, write only the report and status file') contradicts itself: the
#     refusal names both lines and prints the containment line to remove -
#     the author replaces it with an explicit exception naming the same
#     paths the declaration declares.
#   - A brief that names an absolute path outside the home as a write target
#     with no declaration is refused with the exact 'Write outside worktree:'
#     line to add. A path counts only on a line that also carries one of the
#     write verbs (edit, apply, write, paste, install, modify, overwrite,
#     create) or on a line under a 'Files:' / 'Files to change' heading, and
#     never when it sits under the task's data directory, the state
#     directory, the home, the recorded worktree, or the installation whose
#     checker judges it - the scaffold writes that installation's own tool
#     paths ($FM_ROOT/bin/...) into every brief, and those lines are
#     commands, not write targets (in the standard layout the installation
#     is the home, so nothing changes there). The scan classifies
#     lines, never prose: a line it cannot clearly read as a write target
#     passes, so a false positive cannot stop a legitimate dispatch, and an
#     ambiguous form (a tilde path, a URL, a relative path) is left alone.
#
# Scope. Ship and scout briefs (data/<task-id>/brief.md). A secondmate
# charter is a standing contract, not a slice brief, and never reaches this
# check. A brief that does not exist is not judged here: bin/fm-spawn.sh's
# own brief check owns absence and prints its own refusal.
#
# Exit codes:
#   0  the brief carries every element it must; stdout says so.
#   1  the brief is defective - an element is missing or a write-scope
#      refusal fired; stdout lists every finding with the exact line to add
#      or remove.
#   2  bad usage, or the file exists but cannot be read as a regular file;
#      stdout says why (a refusal either way when called from the policy).
set -u

usage() {
  printf 'usage: fm-brief-intake-check <brief-file>\n' >&2
  exit 2
}

[ "$#" -eq 1 ] || usage
BRIEF=$1

[ -e "$BRIEF" ] || {
  printf 'brief intake cannot judge %s: no such file\n' "$BRIEF"
  exit 2
}
[ -f "$BRIEF" ] && [ -r "$BRIEF" ] || {
  printf 'brief intake cannot judge %s: not a readable regular file\n' "$BRIEF"
  exit 2
}

# A marker line: optional indentation and markdown bullet, the exact marker,
# then a non-blank value on the same line.
BULLET='^[[:space:]]*(-[[:space:]]+|\*[[:space:]]+|\+[[:space:]]+)?'

# has_marker <regex>: HAS=1 when the brief carries the marker line, HAS=0
# when it does not. A grep that cannot read the file refuses the run.
HAS=0
has_marker() {
  grep -E -q -- "$1" "$BRIEF"
  case "$?" in
    0) HAS=1 ;;
    1) HAS=0 ;;
    *)
      printf 'brief intake cannot judge %s: it could not be read while checking\n' "$BRIEF"
      exit 2
      ;;
  esac
}

# has_fixed <string>: HAS=1 when the brief contains the fixed string, HAS=0
# when it does not (one fixed string, so a paraphrase never trips it). A grep
# that cannot read the file refuses the run, like has_marker.
HAS=0
has_fixed() {
  grep -F -q -- "$1" "$BRIEF"
  case "$?" in
    0) HAS=1 ;;
    1) HAS=0 ;;
    *)
      printf 'brief intake cannot judge %s: it could not be read while checking\n' "$BRIEF"
      exit 2
      ;;
  esac
}

has_marker "$BULLET"'Delivers:[[:space:]]*[^[:space:]]'
delivers=$HAS
has_marker "$BULLET"'Defers:[[:space:]]*[^[:space:]]'
defers=$HAS
has_marker "$BULLET"'Checks:[[:space:]]*[^[:space:]]'
checks=$HAS
has_marker "$BULLET"'Composition:[[:space:]]*[^[:space:]]'
composition=$HAS

bounds=$(grep -E -c -- "$BULLET"'Bound:[[:space:]]*[^[:space:]]' "$BRIEF")
case "$?" in
  0|1) ;;
  *)
    printf 'brief intake cannot judge %s: it could not be read while checking\n' "$BRIEF"
    exit 2
    ;;
esac

violations=()
if [ "$delivers" -eq 0 ] && [ "$defers" -eq 0 ]; then
  violations+=("slice scope: the brief states neither what this slice delivers nor what it defers - add one line 'Delivers: <what this slice delivers>' and one line 'Defers: <what this slice defers, or nothing>'")
elif [ "$delivers" -eq 0 ]; then
  violations+=("slice scope: the brief does not state what this slice delivers - add one line 'Delivers: <what this slice delivers>'")
elif [ "$defers" -eq 0 ]; then
  violations+=("slice scope: the brief does not state what this slice defers - add one line 'Defers: <what this slice defers, or nothing>'")
fi
if [ "$checks" -eq 0 ]; then
  violations+=("project check set: the brief names no check set - add one line 'Checks: <the project's full check set, resolved at intake from the project's own scripts or CI, never from memory>'")
fi
if [ "$bounds" -ge 2 ] && [ "$composition" -eq 0 ]; then
  violations+=("promise composition: the brief states $bounds bounded promises (Bound:) but no composition for them - add one line 'Composition: <how those bounded promises compose when they conflict, and the test that pins that combined promise>'")
fi

# --- write-scope refusals ---------------------------------------------------
# The declaration marker is an own-line marker like the elements above; the
# containment sentence is matched as one fixed string, so only the scaffold's
# exact sentence counts.
has_marker "$BULLET"'Write outside worktree:[[:space:]]*[^[:space:]]'
writes=$HAS
CONTAINMENT='Stay inside this worktree; outside it, write only the report and status file'
has_fixed "$CONTAINMENT"
containment=$HAS

if [ "$writes" -eq 1 ]; then
  if [ "$containment" -eq 1 ]; then
    decl_line=$(grep -E -m1 -- "$BULLET"'Write outside worktree:' "$BRIEF" || true)
    cont_line=$(grep -F -m1 -- "$CONTAINMENT" "$BRIEF" || true)
    violations+=("write scope conflict: the brief both declares '$decl_line' and still carries the standard containment line '$cont_line' - remove that containment line and replace it with an explicit exception naming the same paths as the declaration")
  fi
else
  # Roots for the undeclared-target scan. The launch policy's FM_LP_*
  # contract is authoritative when present (it names the home and the
  # task's data directory exactly as the scaffold wrote them, including
  # FM_DATA_OVERRIDE / FM_STATE_OVERRIDE layouts where data lives outside
  # the home); otherwise the canonical brief layout <home>/data/<task>/
  # brief.md yields both from the path itself (relative paths resolve
  # against the current directory). Without a home there is no 'outside the
  # home' to judge, so the scan is skipped rather than guessed - a path the
  # scan cannot place passes, never the other way.
  home_dir=
  task_data_dir=
  state_dir=
  worktree_dir=
  if [ -n "${FM_LP_HOME:-}" ] && [ -n "${FM_LP_DATA:-}" ] && [ -n "${FM_LP_TASK:-}" ]; then
    home_dir=$FM_LP_HOME
    task_data_dir=$FM_LP_DATA/$FM_LP_TASK
  elif [ "$(basename "$BRIEF")" = brief.md ] \
    && [ "$(basename "$(dirname "$(dirname "$BRIEF")")")" = data ]; then
    task_data_dir=$(cd "$(dirname "$BRIEF")" && pwd) || task_data_dir=
    home_dir=$(cd "$(dirname "$(dirname "$(dirname "$BRIEF")")")" && pwd) || home_dir=
  else
    home_dir=${FM_HOME:-}
  fi
  home_dir=${home_dir%/}
  task_data_dir=${task_data_dir%/}
  if [ -n "${FM_LP_STATE:-}" ]; then
    state_dir=${FM_LP_STATE%/}
  elif [ -n "$home_dir" ]; then
    state_dir=$home_dir/state
  fi
  # The worktree exemption comes from the task record when one exists: at a
  # fresh spawn neither the record nor the worktree exists yet, so no path
  # can sit under one; at relaunch the record names it.
  task_id=${FM_LP_TASK:-$(basename "$(dirname "$BRIEF")")}
  if [ -n "$state_dir" ] && [ -f "$state_dir/$task_id.meta" ]; then
    worktree_dir=$(grep '^worktree=' "$state_dir/$task_id.meta" | tail -n 1 | sed 's/^worktree=//') || worktree_dir=
    worktree_dir=${worktree_dir%/}
  fi
  # The installation running this check, where the scaffold that generated
  # this brief also lives: its own tool paths ($FM_ROOT/bin/...) are cited
  # absolutely in every generated brief (the status ledger, the
  # ensure-agents-md prohibition whose write verb's object is the relative
  # AGENTS.md, the lab helpers), and a dispatched worker never writes the
  # installation - its writes are the worktree. Those citations are
  # commands, not write targets, so paths under the installation root pass.
  install_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd) || install_root=
  if [ -n "$home_dir" ]; then
    undeclared=$(awk -v home="$home_dir" -v tdata="$task_data_dir" -v state="$state_dir" -v wt="$worktree_dir" -v iroot="$install_root" '
      function under(p, r) { return r != "" && (p == r || index(p, r "/") == 1) }
      {
        line = $0
        low = tolower(line)
        # A blank line or a new markdown heading ends a files-to-change
        # list; a Files: / Files to change heading starts one, and its lines
        # are write targets even without a verb (the list is what changes).
        if (line ~ /^[[:space:]]*$/) { infl = 0; next }
        if (line ~ /^[[:space:]]*#+[[:space:]]/) infl = 0
        if (low ~ /^[[:space:]]*(-[[:space:]]+|\*+[[:space:]]*|\+[[:space:]]+)?(#+[[:space:]]+)?files(:|[[:space:]]+to[[:space:]]+change[[:space:]]*:?)/) infl = 1
        ctx = infl
        if (low ~ /(^|[^a-z0-9_])(edit|apply|write|paste|install|modify|overwrite|create)([^a-z0-9_]|$)/) ctx = 1
        if (!ctx) next
        rest = line
        base = 0
        while (match(rest, /(\/[A-Za-z0-9._][A-Za-z0-9._+@%~-]*)+/)) {
          abs_start = base + RSTART
          p = substr(rest, RSTART, RLENGTH)
          # A trailing sentence period is punctuation, not part of the path.
          sub(/[.]+$/, "", p)
          keep = 1
          if (abs_start > 1) {
            prev = substr(line, abs_start - 1, 1)
            # An absolute path must start the line or follow a delimiter; a
            # preceding word character or path character means a URL, a
            # relative path, or a shell expansion, all of which pass.
            if (prev ~ /[A-Za-z0-9]/ || index("/:~$&%{}).,>_*+-", prev) > 0) keep = 0
            # A quote directly after a word character closes the previously
            # scanned token, so what follows it is a fragment of that token
            # rather than a new absolute path (the steering-inbox mv rule
            # emits paths of that shape) - ambiguous, so it passes.
            else if ((prev == "\047" || prev == "\042" || prev == "\140") && abs_start > 2 && substr(line, abs_start - 2, 1) ~ /[A-Za-z0-9]/) keep = 0
          }
          base = abs_start + RLENGTH - 1
          rest = substr(line, base + 1)
          if (!keep || length(p) < 2) continue
          if (under(p, home) || under(p, tdata) || under(p, state) || under(p, wt) || under(p, iroot)) continue
          if (!(p in seen)) { seen[p] = 1; print p }
        }
      }
    ' "$BRIEF")
    case "$?" in
      0) ;;
      *)
        printf 'brief intake cannot judge %s: it could not be read while checking\n' "$BRIEF"
        exit 2
        ;;
    esac
    if [ -n "$undeclared" ]; then
      undeclared=$(printf '%s\n' "$undeclared" | paste -sd ' ' -)
      violations+=("undeclared write target: the brief names $undeclared as a write target outside the home without declaring it - add one line 'Write outside worktree: $undeclared'")
    fi
  fi
fi

if [ "${#violations[@]}" -gt 0 ]; then
  detail=
  for v in "${violations[@]}"; do
    detail="$detail${detail:+; }$v"
  done
  printf 'brief intake refused %s: %s\n' "$BRIEF" "$detail"
  exit 1
fi
printf 'ok: brief intake elements present: %s\n' "$BRIEF"
exit 0
