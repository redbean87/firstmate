#!/usr/bin/env bash
# fm-fork-hook-check - prove the fork's ten upstream integration points are
# present, unmodified, and at their lifecycle positions, and (with --base) that
# no other upstream-owned file differs from upstream.
#
# Usage: fm-fork-hook-check [--root <repo>] [--base <upstream-ref>]
#
# Checks:
#   - HK1 appears exactly once in bin/fm-spawn.sh, byte-identical to
#     fork/hooks/hk1-spawn.block, after the project capacity admission and
#     directly before the brief check, so before the launch-brief render and
#     the first endpoint step (`W="fm-$ID"`); every upstream variable it reads
#     is assigned earlier in the file and none is reassigned before launch.
#   - HK2 appears exactly once in bin/fm-control.sh, byte-identical to
#     fork/hooks/hk2-control.block, inside do_relaunch() after
#     resolve_relaunch_profile and before safe_checkpoint and do_exit; the
#     upstream names it reads exist in that file.
#   - HK3 appears exactly once in bin/fm-watch.sh, byte-identical to
#     fork/hooks/hk3-watch.block, inside resurface_after_downtime() after the
#     ordinary branch's fi and directly before the trailing wake, so both the
#     ordinary branch and the WATCHER_RECOVERY_PENDING=1 fall-through reach
#     the guard before the wake; it calls fork_main_eligible_queued_row, which
#     must exist before the function. (Upstream's own queue gate on this path,
#     handling_successor_has_queued_row, was removed upstream; the main-eligible
#     count is a stricter, fresh read of the same queue.)
#   - HK4 appears exactly once in bin/fm-watch.sh, byte-identical to
#     fork/hooks/hk4-main-eligible.block, directly before
#     resurface_after_downtime(); it defines fork_main_eligible_queued_row on
#     upstream's fm_wake_actor_pending_count, which bin/fm-wake-lib.sh defines
#     and bin/fm-watch.sh reaches through its fm-push-transition-lib.sh source.
#   - HK5 appears exactly once in bin/fm-watch.sh, byte-identical to
#     fork/hooks/hk5-resurface-successor.block, inside the
#     FM_WATCH_HANDLING_SUCCESSOR branch of resurface_after_downtime() between
#     upstream's own queue gate (the FM_RECOVERY_MARKER_QUEUED check) and that
#     branch's trailing wake - the site the
#     Pi extension's post-wake successor arms actually reach - and after HK4's
#     definition.
#   - HK6 appears exactly once in bin/fm-watch.sh, byte-identical to
#     fork/hooks/hk6-parked-review.block, inside the terminal-status stale
#     branch between the captain-call absorb and the surfacing else; the
#     upstream names it reads exist in bin/fm-watch.sh,
#     bin/fm-classify-lib.sh, or bin/fm-backend.sh.
#   - HK7 appears exactly once in bin/fm-extension.mjs, byte-identical to
#     fork/hooks/hk7-result-configref.block, inside invokeProcessEvent's
#     captured-result branch directly after upstream's input assignment, so a
#     captured-result operation (result.classify, result.terminal,
#     result.silent) carries the home reference an extension needs to judge a
#     capture against its own task records; the upstream names it reads (the
#     invokeProcessEvent home parameter, the captured input assignment) exist
#     in that file.
#   - HK8 appears exactly once in bin/fm-spawn.sh, byte-identical to
#     fork/hooks/hk8-registry-key.block, directly after upstream's
#     `PROJ_NAME=$(basename "$PROJ_ABS")` resolution and before the first
#     posture query that reads $PROJ_NAME, so every standing-posture lookup
#     (forge, mode, PR text, ship-branch prefix) runs against the key
#     fork/bin/fm-registry-key resolves; the upstream names it reads (PROJ_ABS,
#     FM_ROOT, ID) are assigned earlier in the file.
#   - HK9 appears exactly once in bin/fm-tool-update-check.sh, byte-identical to
#     fork/hooks/hk9-tool-update.block, directly before the action dispatch, so
#     its redefinitions and per-tool slice state are in place before
#     `case "${1:-check}"` runs action_check; every upstream name it reads is
#     defined earlier in that file.
#   - HK10 appears exactly once in bin/fm-composer-lib.sh, byte-identical to
#     fork/hooks/hk10-composer-hud.block, inside _fm_composer_scan_screen
#     directly before its row loop, so the themed-HUD pre-filter runs on every
#     scan; the upstream names it reads (the pane local, the row loop, and
#     fm_composer_normalize_trim_var) exist in that file.
#   - No upstream-owned bin/ file other than the launch-policy hook files
#     references fork code.
#   - --base: `git diff <ref>` outside fork/ and the fork CI workflow touches
#     only the six hooked files, and only by adding their canonical hook
#     blocks (every block the base lacks, in file order).
# Prints one `ok:` or `FAIL:` line per check; exits 1 if any check fails.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
BASE=
while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT=$(cd "${2:?--root needs a path}" && pwd); shift 2 ;;
    --base) BASE=${2:?--base needs a ref}; shift 2 ;;
    -h|--help) sed -n '2,73p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "fm-fork-hook-check: unknown argument $1" >&2; exit 2 ;;
  esac
done

FAILED=0
ok() { printf 'ok: %s\n' "$1"; }
bad() { printf 'FAIL: %s\n' "$1"; FAILED=1; }

SPAWN="$ROOT/bin/fm-spawn.sh"
CONTROL="$ROOT/bin/fm-control.sh"
WATCH="$ROOT/bin/fm-watch.sh"
EXTENSION="$ROOT/bin/fm-extension.mjs"
TOOLCHECK="$ROOT/bin/fm-tool-update-check.sh"
COMPOSER="$ROOT/bin/fm-composer-lib.sh"
HK1="$ROOT/fork/hooks/hk1-spawn.block"
HK2="$ROOT/fork/hooks/hk2-control.block"
HK3="$ROOT/fork/hooks/hk3-watch.block"
HK4="$ROOT/fork/hooks/hk4-main-eligible.block"
HK5="$ROOT/fork/hooks/hk5-resurface-successor.block"
HK6="$ROOT/fork/hooks/hk6-parked-review.block"
HK7="$ROOT/fork/hooks/hk7-result-configref.block"
HK8="$ROOT/fork/hooks/hk8-registry-key.block"
HK9="$ROOT/fork/hooks/hk9-tool-update.block"
HK10="$ROOT/fork/hooks/hk10-composer-hud.block"
for f in "$SPAWN" "$CONTROL" "$WATCH" "$EXTENSION" "$TOOLCHECK" "$COMPOSER" "$HK1" "$HK2" "$HK3" "$HK4" "$HK5" "$HK6" "$HK7" "$HK8" "$HK9" "$HK10"; do
  [ -f "$f" ] || { bad "missing file ${f#"$ROOT"/}"; exit 1; }
done

line_of() { grep -nxF -- "$2" "$1" | head -1 | cut -d: -f1; }
count_of() { grep -cxF -- "$2" "$1"; }
first_assignment() { grep -nE "^[[:space:]]*(local[[:space:]]+)?$2=" "$1" | head -1 | cut -d: -f1; }

# find_block <file> <block> <label>: exactly one begin/end marker pair whose
# enclosed text equals the canonical block. Sets BLOCK_BEGIN and BLOCK_END.
find_block() {
  local file=$1 block=$2 label=$3 begin_marker end_marker nb ne
  BLOCK_BEGIN=
  BLOCK_END=
  begin_marker=$(head -1 "$block")
  end_marker=$(tail -1 "$block")
  nb=$(count_of "$file" "$begin_marker")
  ne=$(count_of "$file" "$end_marker")
  if [ "$nb" != 1 ] || [ "$ne" != 1 ]; then
    bad "$label: expected exactly one hook block in ${file#"$ROOT"/} (found $nb begin and $ne end markers)"
    return 1
  fi
  BLOCK_BEGIN=$(line_of "$file" "$begin_marker")
  BLOCK_END=$(line_of "$file" "$end_marker")
  if [ "$BLOCK_END" -le "$BLOCK_BEGIN" ] || ! sed -n "${BLOCK_BEGIN},${BLOCK_END}p" "$file" | cmp -s - "$block"; then
    bad "$label: hook block in ${file#"$ROOT"/} differs from ${block#"$ROOT"/}"
    return 1
  fi
  ok "$label: present once and identical to ${block#"$ROOT"/}"
}

# --- HK1: bin/fm-spawn.sh ----------------------------------------------------
if find_block "$SPAWN" "$HK1" HK1; then
  # Anchor: directly after upstream's project-capacity admission and before
  # the brief checks, so a refusal leaves no launch brief, endpoint, worktree,
  # or task record - the same no-side-effect point upstream's own capacity
  # deferral uses.
  capacity=$(grep -nE '^# Project capacity admission' "$SPAWN" | head -1 | cut -d: -f1)
  # shellcheck disable=SC2016 # literal upstream source lines
  brief_check=$(line_of "$SPAWN" '[ -f "$BRIEF" ] || {')
  # shellcheck disable=SC2016 # literal upstream source line
  render=$(grep -nF 'BRIEF="$DATA/$ID/launch-brief.md"' "$SPAWN" | head -1 | cut -d: -f1)
  # shellcheck disable=SC2016 # literal upstream source line
  endpoint=$(line_of "$SPAWN" 'W="fm-$ID"')
  next=$(awk -v n="$BLOCK_END" 'NR > n && NF { print NR; exit }' "$SPAWN")
  if [ -z "$capacity" ] || [ -z "$brief_check" ] || [ -z "$render" ] || [ -z "$endpoint" ]; then
    bad "HK1: an upstream anchor is gone (capacity admission, brief check, launch-brief render, or W=\"fm-\$ID\"); re-anchor the block"
  elif [ "$next" != "$brief_check" ] || [ "$BLOCK_BEGIN" -le "$capacity" ]; then
    bad "HK1: block must sit after project capacity admission (line $capacity) and directly before the brief check (line $brief_check)"
  elif [ "$BLOCK_END" -ge "$render" ] || [ "$BLOCK_END" -ge "$endpoint" ]; then
    bad "HK1: block must come before the launch-brief render ($render) and the first endpoint step ($endpoint)"
  else
    ok "HK1: after capacity admission ($capacity), before the brief check ($brief_check), launch-brief render ($render) and first endpoint step ($endpoint)"
  fi
  missing=
  for var in ID KIND PROJ_ABS HARNESS MODEL EFFORT RELAUNCH RAW_LAUNCH LAUNCH STATE DATA CONFIG FM_HOME FM_ROOT; do
    at=$(first_assignment "$SPAWN" "$var")
    if [ -z "$at" ] || [ "$at" -ge "$BLOCK_BEGIN" ]; then missing="$missing $var"; fi
  done
  if [ -n "$missing" ]; then
    bad "HK1: upstream contract variables not assigned before the block:$missing"
  else
    ok "HK1: every upstream contract variable is assigned before the block"
  fi
  # The values the block reads must be final: nothing may reassign them
  # between the block and the first endpoint step.
  late=$(awk -v s="$BLOCK_END" -v e="$endpoint" 'NR > s && NR < e && /^[[:space:]]*(ID|KIND|PROJ_ABS|HARNESS|MODEL|EFFORT|RELAUNCH|RAW_LAUNCH|LAUNCH|STATE|DATA|CONFIG|FM_HOME|FM_ROOT)=/ { printf " %d", NR }' "$SPAWN")
  if [ -n "$late" ]; then
    bad "HK1: a contract variable is reassigned after the block, before launch (lines$late); the policy would judge a stale value"
  else
    ok "HK1: no contract variable is reassigned between the block and launch"
  fi
fi

# --- HK2: bin/fm-control.sh relaunch ----------------------------------------
if find_block "$CONTROL" "$HK2" HK2; then
  fn_start=$(grep -nE '^do_relaunch\(\) \{' "$CONTROL" | head -1 | cut -d: -f1)
  if [ -z "$fn_start" ]; then
    bad "HK2: upstream function do_relaunch() not found; re-anchor the block"
  else
    fn_end=$(awk -v s="$fn_start" 'NR > s && /^}/ { print NR; exit }' "$CONTROL")
    profile=$(awk -v s="$fn_start" -v e="$fn_end" 'NR > s && NR < e && /^[[:space:]]*resolve_relaunch_profile[[:space:]]*$/ { print NR; exit }' "$CONTROL")
    checkpoint=$(awk -v s="$fn_start" -v e="$fn_end" 'NR > s && NR < e && /^[[:space:]]*safe_checkpoint[[:space:]]*$/ { print NR; exit }' "$CONTROL")
    stop=$(awk -v s="$fn_start" -v e="$fn_end" 'NR > s && NR < e && /do_exit/ { print NR; exit }' "$CONTROL")
    if [ "$BLOCK_BEGIN" -le "$fn_start" ] || [ -z "$fn_end" ] || [ "$BLOCK_END" -ge "$fn_end" ]; then
      bad "HK2: block must sit inside do_relaunch() (lines $fn_start-$fn_end)"
    elif [ -z "$profile" ] || [ "$profile" -ge "$BLOCK_BEGIN" ]; then
      bad "HK2: block must follow resolve_relaunch_profile, which sets the relaunch target"
    elif [ -z "$checkpoint" ] || [ -z "$stop" ] || [ "$BLOCK_END" -ge "$checkpoint" ] || [ "$BLOCK_END" -ge "$stop" ]; then
      bad "HK2: block must come before safe_checkpoint and do_exit, so a refusal never stops the agent"
    else
      ok "HK2: inside do_relaunch(), after resolve_relaunch_profile, before safe_checkpoint ($checkpoint) and do_exit ($stop)"
    fi
  fi
  missing=
  for var in TARGET_HARNESS TARGET_MODEL TARGET_EFFORT META KIND STATE DATA FM_ROOT; do
    [ -n "$(first_assignment "$CONTROL" "$var")" ] || missing="$missing $var"
  done
  grep -qE '^[[:space:]]*die\(\)' "$CONTROL" || missing="$missing die()"
  grep -qE 'fm-backend\.sh' "$CONTROL" || missing="$missing fm_meta_get(bin/fm-backend.sh)"
  if [ -n "$missing" ]; then
    bad "HK2: upstream contract names not found in bin/fm-control.sh:$missing"
  else
    ok "HK2: every upstream contract name exists"
  fi
fi

# --- HK3: bin/fm-watch.sh resurface guard -------------------------------------
if find_block "$WATCH" "$HK3" HK3; then
  fn_start=$(grep -nE '^resurface_after_downtime\(\) \{' "$WATCH" | head -1 | cut -d: -f1)
  fn_end=
  if [ -n "$fn_start" ]; then
    fn_end=$(awk -v s="$fn_start" 'NR > s && /^}/ { print NR; exit }' "$WATCH")
  fi
  # The ordinary branch's recover check: the handling-successor branch has the
  # same line, so the anchor is the LAST such line inside the function - the
  # one whose branch falls through to the trailing wake. The block must sit
  # after that branch's fi and immediately before the trailing wake, the one
  # point both the ordinary branch and the WATCHER_RECOVERY_PENDING=1
  # fall-through cross before any resurface wake.
  # shellcheck disable=SC2016 # literal upstream source line
  recover_line=$(grep -nxF -- '    [ "$FM_RECOVERY_MARKER_ACTION" = recover ] || return 0' "$WATCH" \
    | awk -F: -v s="${fn_start:-0}" -v e="${fn_end:-0}" '$1 > s && $1 < e { last = $1 } END { print last }')
  if [ -z "$fn_start" ] || [ -z "$fn_end" ]; then
    bad "HK3: upstream function resurface_after_downtime() not found; re-anchor the block"
  elif [ "$BLOCK_BEGIN" -le "$fn_start" ] || [ "$BLOCK_END" -ge "$fn_end" ]; then
    bad "HK3: block must sit inside resurface_after_downtime() (lines $fn_start-$fn_end)"
  elif [ -z "$recover_line" ] || [ "$BLOCK_BEGIN" -le "$recover_line" ]; then
    bad "HK3: block must sit after the ordinary branch's recover check${recover_line:+ (line $recover_line)} in resurface_after_downtime()"
  elif [ "$(sed -n "$((BLOCK_BEGIN - 1))p" "$WATCH")" != '  fi' ] \
    || [ "$(sed -n "$((BLOCK_END + 1))p" "$WATCH")" != '  wake "check: rearm-resurface"' ]; then
    bad "HK3: block must sit between the ordinary branch's fi (line $((BLOCK_BEGIN - 1))) and the trailing wake (line $((BLOCK_END + 1)))"
  else
    ok "HK3: inside resurface_after_downtime(), after the recover check ($recover_line) and the branch fi ($((BLOCK_BEGIN - 1))), before the trailing wake ($((BLOCK_END + 1)))"
  fi
  fork_helper=$(grep -nxF 'fork_main_eligible_queued_row() {' "$WATCH" | head -1 | cut -d: -f1)
  if [ -z "$fork_helper" ]; then
    bad "HK3: fork helper fork_main_eligible_queued_row() not found; the block calls it (HK4 defines it)"
  elif [ -n "$fn_start" ] && [ "$fork_helper" -ge "$fn_start" ]; then
    bad "HK3: fork_main_eligible_queued_row must be defined before resurface_after_downtime() (line $fork_helper)"
  else
    ok "HK3: the guard the block calls exists before resurface_after_downtime() (line $fork_helper)"
  fi
fi

# --- HK4: bin/fm-watch.sh main-eligible guard definition ---------------------
if find_block "$WATCH" "$HK4" HK4; then
  fn_start=$(grep -nE '^resurface_after_downtime\(\) \{' "$WATCH" | head -1 | cut -d: -f1)
  if [ -z "$fn_start" ]; then
    bad "HK4: upstream anchor resurface_after_downtime() is gone; re-anchor the block"
  elif [ "$BLOCK_END" -ne $(( fn_start - 1 )) ]; then
    bad "HK4: block must sit directly before resurface_after_downtime() (line $fn_start), whose guards call it"
  elif ! grep -qxF 'fork_main_eligible_queued_row() {' "$HK4" \
    || ! grep -q 'fm_wake_actor_pending_count main' "$HK4"; then
    bad "HK4: the block must define fork_main_eligible_queued_row on fm_wake_actor_pending_count main"
  else
    ok "HK4: directly before resurface_after_downtime() ($fn_start), defining the main-eligible guard"
    HK4_BLOCK_END=$BLOCK_END
  fi
  if ! grep -qE '^fm_wake_actor_pending_count\(\)' "$ROOT/bin/fm-wake-lib.sh"; then
    bad "HK4: upstream fm_wake_actor_pending_count() not found in bin/fm-wake-lib.sh"
  elif ! grep -q 'fm-wake-lib.sh' "$ROOT/bin/fm-push-transition-lib.sh" \
    || ! grep -q 'fm-push-transition-lib.sh' "$WATCH"; then
    bad "HK4: bin/fm-watch.sh no longer reaches bin/fm-wake-lib.sh through fm-push-transition-lib.sh"
  else
    ok "HK4: the filter it calls is defined upstream and reachable from bin/fm-watch.sh"
  fi
fi

# --- HK5: bin/fm-watch.sh handling-successor resurface guard -----------------
if find_block "$WATCH" "$HK5" HK5; then
  fn_start=$(grep -nE '^resurface_after_downtime\(\) \{' "$WATCH" | head -1 | cut -d: -f1)
  fn_end=
  if [ -n "$fn_start" ]; then
    fn_end=$(awk -v s="$fn_start" 'NR > s && /^}/ { print NR; exit }' "$WATCH")
  fi
  # The branch's own upstream gate (four-space indent, inside the
  # handling-successor branch).
  # shellcheck disable=SC2016 # literal upstream source line
  upstream_gate=$(grep -nxF -- '    [ "$FM_RECOVERY_MARKER_QUEUED" = 1 ] || return 0' "$WATCH" | head -1 | cut -d: -f1)
  # shellcheck disable=SC2016 # literal upstream source line
  branch_wake=$(grep -nxF -- '    wake "check: rearm-resurface"' "$WATCH" | head -1 | cut -d: -f1)
  if [ -z "$fn_start" ] || [ -z "$fn_end" ]; then
    bad "HK5: upstream function resurface_after_downtime() not found; re-anchor the block"
  elif [ "$BLOCK_BEGIN" -le "$fn_start" ] || [ "$BLOCK_END" -ge "$fn_end" ]; then
    bad "HK5: block must sit inside resurface_after_downtime() (lines $fn_start-$fn_end)"
  elif [ -z "$upstream_gate" ] || [ -z "$branch_wake" ] \
    || [ "$BLOCK_BEGIN" -ne $(( upstream_gate + 1 )) ] \
    || [ "$BLOCK_END" -ne $(( branch_wake - 1 )) ]; then
    bad "HK5: block must sit between the handling-successor branch's upstream queue gate${upstream_gate:+ (line $upstream_gate)} and that branch's trailing wake${branch_wake:+ (line $branch_wake)}"
  elif [ -z "${HK4_BLOCK_END:-}" ] || [ "$BLOCK_BEGIN" -le "$HK4_BLOCK_END" ]; then
    bad "HK5: block must sit after HK4 defines fork_main_eligible_queued_row (line ${HK4_BLOCK_END:-missing})"
  else
    ok "HK5: inside the handling-successor branch, after its upstream gate ($upstream_gate), before its wake ($branch_wake), after HK4"
  fi
fi

# --- HK6: bin/fm-watch.sh parked-awaiting-review absorb -----------------------
if find_block "$WATCH" "$HK6" HK6; then
  # shellcheck disable=SC2016 # literal upstream source line
  captain_triage=$(grep -nF -- 'triage_log "absorbed stale (open captain call already surfaced for this status): $w"' "$WATCH" | head -1 | cut -d: -f1)
  if [ -z "$captain_triage" ]; then
    bad "HK6: an upstream anchor is gone (the captain-call absorb triage_log); re-anchor the block"
  elif [ "$BLOCK_BEGIN" -ne $(( captain_triage + 1 )) ]; then
    bad "HK6: block must sit directly after the captain-call absorb branch (line $captain_triage)"
  elif [ "$(sed -n "$((BLOCK_END + 1))p" "$WATCH")" != '            else' ]; then
    bad "HK6: block must sit directly before the surfacing else (line $((BLOCK_END + 1)))"
  else
    ok "HK6: after the captain-call absorb ($captain_triage), before the surfacing else ($((BLOCK_END + 1)))"
  fi
  missing=
  for fn in wedge_episode_end clear_write_tracking resurface_absorbed; do
    grep -qE "^${fn}\\(\\)" "$WATCH" || missing="$missing $fn"
  done
  # stat_mtime lives inside fm-watch.sh's platform if/else, so it is indented.
  grep -qE '^[[:space:]]*stat_mtime\(\)' "$WATCH" || missing="$missing stat_mtime"
  # triage_log comes from the transition owner this watcher sources first.
  grep -qE '^triage_log\(\)' "$ROOT/bin/fm-push-transition-lib.sh" || missing="$missing triage_log"
  for fn in last_status_line status_line_verb; do
    grep -qE "^${fn}\\(\\)" "$ROOT/bin/fm-classify-lib.sh" || missing="$missing $fn"
  done
  grep -qE '^fm_meta_get\(\)' "$ROOT/bin/fm-backend.sh" || missing="$missing fm_meta_get"
  if ! grep -q 'fm-classify-lib.sh' "$ROOT/bin/fm-push-transition-lib.sh" \
    || ! grep -q 'fm-backend.sh' "$ROOT/bin/fm-push-transition-lib.sh"; then
    bad "HK6: bin/fm-watch.sh no longer reaches fm-classify-lib.sh/fm-backend.sh through fm-push-transition-lib.sh"
  elif [ -n "$missing" ]; then
    bad "HK6: upstream names the block reads are missing:$missing"
  else
    ok "HK6: every upstream name the block reads exists and is reachable"
  fi
fi

# --- HK7: bin/fm-extension.mjs captured-result config_ref --------------------
if find_block "$EXTENSION" "$HK7" HK7; then
  # Anchor: inside invokeProcessEvent's captured-result branch, directly after
  # upstream's input assignment and before the branch ends, so exactly the
  # captured-result operations (result.classify, result.terminal,
  # result.silent) gain the home reference and no other invocation changes.
  # shellcheck disable=SC2016 # literal upstream source line
  fn=$(grep -nF 'async function invokeProcessEvent(home, adapter, operation, options) {' "$EXTENSION" | head -1 | cut -d: -f1)
  # shellcheck disable=SC2016 # literal upstream source line
  upstream_input=$(grep -nF 'input = { source_id: captured.sourceId, sequence: captured.sequence, content: captured.content };' "$EXTENSION" | head -1 | cut -d: -f1)
  if [ -z "$fn" ] || [ -z "$upstream_input" ]; then
    bad "HK7: an upstream anchor is gone (invokeProcessEvent or its captured input assignment); re-anchor the block"
  elif [ "$BLOCK_BEGIN" -ne $(( upstream_input + 1 )) ]; then
    bad "HK7: block must sit directly after the captured-result input assignment (line $upstream_input)"
  elif [ "$BLOCK_BEGIN" -le "$fn" ]; then
    bad "HK7: block must sit inside invokeProcessEvent (line $fn)"
  elif [ "$(sed -n "$((BLOCK_END + 1))p" "$EXTENSION")" != "  }" ]; then
    bad "HK7: block must sit directly before the end of the captured-result branch (line $((BLOCK_END + 1)))"
  else
    ok "HK7: inside invokeProcessEvent ($fn), after the captured input assignment ($upstream_input), before the branch end ($((BLOCK_END + 1)))"
  fi
  if [ -z "$fn" ]; then
    bad "HK7: upstream invokeProcessEvent is not found; the block reads its home parameter"
  else
    ok "HK7: every upstream name the block reads exists"
  fi
fi

# --- HK8: bin/fm-spawn.sh registry-key posture resolution ---------------------
if find_block "$SPAWN" "$HK8" HK8; then
  # Anchor: directly after upstream's basename resolution - the exact lookup
  # this hook corrects - and before the first posture query that reads
  # $PROJ_NAME, so no standing posture is resolved from the raw basename.
  # shellcheck disable=SC2016 # literal upstream source line
  projname=$(line_of "$SPAWN" '  PROJ_NAME=$(basename "$PROJ_ABS")')
  # shellcheck disable=SC2016 # literal upstream source line
  standing_forge=$(grep -nF 'STANDING_FORGE=$("$FM_ROOT/bin/fm-project-mode.sh" --forge "$PROJ_NAME"' "$SPAWN" | head -1 | cut -d: -f1)
  if [ -z "$projname" ] || [ -z "$standing_forge" ]; then
    bad "HK8: an upstream anchor is gone (the PROJ_NAME basename resolution or the first posture query); re-anchor the block"
  elif [ "$BLOCK_BEGIN" -ne $(( projname + 1 )) ]; then
    bad "HK8: block must sit directly after upstream's PROJ_NAME basename resolution (line $projname)"
  elif [ "$BLOCK_END" -ge "$standing_forge" ]; then
    bad "HK8: block must come before the first posture query that reads \$PROJ_NAME (line $standing_forge)"
  else
    ok "HK8: directly after the basename resolution ($projname), before the posture queries ($standing_forge)"
  fi
  missing=
  for var in PROJ_ABS FM_ROOT ID; do
    at=$(first_assignment "$SPAWN" "$var")
    if [ -z "$at" ] || [ "$at" -ge "$BLOCK_BEGIN" ]; then missing="$missing $var"; fi
  done
  if [ -n "$missing" ]; then
    bad "HK8: upstream contract variables not assigned before the block:$missing"
  else
    ok "HK8: every upstream contract variable is assigned before the block"
  fi
fi

# --- HK9: bin/fm-tool-update-check.sh timeout classification ------------------
if find_block "$TOOLCHECK" "$HK9" HK9; then
  # Anchor: directly before the action dispatch, after every upstream function
  # the block redefines, so the definitions action_check's call sites resolve
  # at run time are the block's own.
  # shellcheck disable=SC2016 # literal upstream source line
  dispatch=$(line_of "$TOOLCHECK" 'case "${1:-check}" in')
  if [ -z "$dispatch" ] || [ "$BLOCK_END" -ne $(( dispatch - 1 )) ]; then
    bad "HK9: block must sit directly before the action dispatch${dispatch:+ (line $dispatch)}"
  else
    ok "HK9: directly before the action dispatch ($dispatch)"
  fi
  late=
  for fn in probe_bound budget_exhausted budget_allows git_probe_answered command_findings git_findings action_check; do
    # shellcheck disable=SC2016 # literal upstream definition line
    at=$(line_of "$TOOLCHECK" "$fn() {")
    if [ -z "$at" ]; then late="$late $fn(missing)"; continue; fi
    if [ "$at" -ge "$BLOCK_BEGIN" ]; then late="$late $fn@$at"; fi
  done
  if [ -n "$late" ]; then
    bad "HK9: an upstream function the block redefines or calls is not defined before the block:$late"
  else
    ok "HK9: every upstream function it redefines or calls is defined before the block"
  fi
  missing=
  for var in DEADLINE PROBE_SECS PROBE_MIN_SECS INCOMPLETE_REPORTED GIT_PROBE_NOT_ISSUED; do
    at=$(first_assignment "$TOOLCHECK" "$var")
    if [ -z "$at" ] || [ "$at" -ge "$BLOCK_BEGIN" ]; then missing="$missing $var"; fi
  done
  if [ -n "$missing" ]; then
    bad "HK9: upstream contract names not assigned before the block:$missing"
  else
    ok "HK9: every upstream contract name it reads is assigned before the block"
  fi
  if ! grep -q '^fork_tool_begin() {' "$HK9" \
    || ! grep -q '^fork_global_budget_exhausted() {' "$HK9" \
    || ! grep -q '^probe_bound() {' "$HK9" \
    || ! grep -q '^budget_exhausted() {' "$HK9" \
    || ! grep -q '^budget_allows() {' "$HK9" \
    || ! grep -q '^git_probe_answered() {' "$HK9"; then
    bad "HK9: the block must define fork_tool_begin, fork_global_budget_exhausted, and redefine probe_bound, budget_exhausted, budget_allows, git_probe_answered"
  else
    ok "HK9: the block defines the per-tool slice helpers and redefines the four upstream gates"
  fi
fi

# --- HK10: bin/fm-composer-lib.sh themed-HUD furniture pre-filter -------------
if find_block "$COMPOSER" "$HK10" HK10; then
  # Anchor: inside _fm_composer_scan_screen, directly before its row loop, so
  # the pre-filter rewrites the scan's pane copy before any row is classified.
  fn_start=$(grep -nE '^_fm_composer_scan_screen\(\) \{' "$COMPOSER" | head -1 | cut -d: -f1)
  # shellcheck disable=SC2016 # literal upstream source line
  row_loop=$(line_of "$COMPOSER" '  while IFS= read -r line; do')
  next=$(awk -v n="$BLOCK_END" 'NR > n && NF { print NR; exit }' "$COMPOSER")
  if [ -z "$fn_start" ] || [ -z "$row_loop" ]; then
    bad "HK10: an upstream anchor is gone (_fm_composer_scan_screen or its row loop); re-anchor the block"
  elif [ "$BLOCK_BEGIN" -le "$fn_start" ] || [ "$next" != "$row_loop" ]; then
    bad "HK10: block must sit inside _fm_composer_scan_screen (line $fn_start), directly before its row loop (line $row_loop)"
  else
    ok "HK10: inside _fm_composer_scan_screen ($fn_start), directly before its row loop ($row_loop)"
  fi
  missing=
  grep -qE '^fm_composer_normalize_trim_var\(\)' "$COMPOSER" || missing="$missing fm_composer_normalize_trim_var"
  [ -n "$(first_assignment "$COMPOSER" pane)" ] || missing="$missing pane"
  if [ -n "$missing" ]; then
    bad "HK10: upstream names the block reads are missing:$missing"
  else
    ok "HK10: every upstream name the block reads exists"
  fi
fi

# --- no other fork reference in upstream-owned bin/ ---------------------------
others=$(grep -lE 'fork/bin/|FM_LP_[A-Z]' "$ROOT"/bin/* 2>/dev/null | grep -vxF -e "$SPAWN" -e "$CONTROL" || true)
if [ -n "$others" ]; then
  bad "fork references outside the two hook files: $(printf '%s' "$others" | tr '\n' ' ')"
else
  ok "no fork reference in any other upstream bin/ file"
fi

# --- --base: nothing upstream-owned differs except the hook blocks ------------
if [ -n "$BASE" ]; then
  if ! git -C "$ROOT" rev-parse --verify --quiet "$BASE^{commit}" >/dev/null; then
    bad "--base $BASE is not a commit in $ROOT"
  else
    changed=$(git -C "$ROOT" diff --name-only "$BASE" -- . ':(exclude)fork' ':(exclude).github/workflows/fork-ci.yml' | sort)
    outside=
    for f in $changed; do
      case "$f" in
        bin/fm-control.sh|bin/fm-spawn.sh|bin/fm-watch.sh|bin/fm-extension.mjs|bin/fm-tool-update-check.sh|bin/fm-composer-lib.sh) ;;
        *) outside="$outside $f" ;;
      esac
    done
    if [ -n "$outside" ]; then
      bad "--base $BASE: upstream-owned files differing:${outside# } (expected only bin/fm-control.sh bin/fm-spawn.sh bin/fm-watch.sh bin/fm-extension.mjs bin/fm-tool-update-check.sh bin/fm-composer-lib.sh)"
    else
      # Each hooked file's added lines must be exactly the canonical blocks the
      # BASE copy lacks, concatenated in the working file's own order: a hook
      # the base already carries contributes nothing, and any added line
      # outside a missing block (or a block moved out of order) is extra.
      extra=
      for file in bin/fm-spawn.sh bin/fm-control.sh bin/fm-watch.sh bin/fm-extension.mjs bin/fm-tool-update-check.sh bin/fm-composer-lib.sh; do
        printf '%s\n' "$changed" | grep -qxF -- "$file" || continue
        diff_out=$(git -C "$ROOT" diff -U0 "$BASE" -- "$file")
        deleted=$(printf '%s\n' "$diff_out" | grep -cE '^-([^-]|$)' || true)
        if [ "$deleted" -ne 0 ]; then extra="$extra $file"; continue; fi
        added=$(printf '%s\n' "$diff_out" | grep -E '^\+' | grep -vE '^\+\+\+ ' | sed 's/^+//')
        expected=$(
          case "$file" in
            bin/fm-spawn.sh) set -- "$HK1" "$HK8" ;;
            bin/fm-control.sh) set -- "$HK2" ;;
            bin/fm-watch.sh) set -- "$HK4" "$HK5" "$HK3" "$HK6" ;;
            bin/fm-extension.mjs) set -- "$HK7" ;;
            bin/fm-tool-update-check.sh) set -- "$HK9" ;;
            bin/fm-composer-lib.sh) set -- "$HK10" ;;
          esac
          for block in "$@"; do
            begin=$(head -1 "$block")
            if git -C "$ROOT" show "$BASE:$file" 2>/dev/null | grep -qxF -- "$begin"; then
              continue
            fi
            printf '%s\t%s\n' "$(line_of "$ROOT/$file" "$begin")" "$block"
          done | LC_ALL=C sort -n | cut -f2- | while IFS= read -r b; do cat "$b"; done
        )
        if [ "$added" != "$expected" ]; then extra="$extra $file"; fi
      done
      if [ -n "$extra" ]; then
        bad "--base $BASE: these upstream files differ by more than their hook block:$extra"
      else
        ok "--base $BASE: upstream-owned files differ only by the hook blocks"
      fi
    fi
  fi
fi

exit "$FAILED"
